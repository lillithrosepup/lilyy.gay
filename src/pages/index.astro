---
// 2026-10-17T04:31:53.309Z - recreated by lucia~<3
import NowPlaying from "../components/NowPlaying.astro";
import Tooltip from "../components/Tooltip.astro";
import CoreLayout from "../layouts/Core.astro";

// fuck this
// TODO: make this not compile-time
const birthday = new Date("2006-11-17T05:00:00.000Z");
const now = new Date();
let age = now.getFullYear() - birthday.getFullYear();
const hadBirthday =
  now.getMonth() > birthday.getMonth() ||
  (now.getMonth() === birthday.getMonth() &&
    now.getDate() >= birthday.getDate());
if (!hadBirthday) age--;

/**
 * either a raw string, or [text, tooltip, showUnderline]
 */
const smallThings: (string | [string, string, boolean?])[] = [
  [
    `I'm ${age} years old.`,
    birthday.toLocaleDateString("en-US", { month: "long", year: "numeric" }),
  ],
];
const languages: {
  name: string;
  url?: string;
  tooltip?: string;
  underline?: boolean;
}[] = [
  {
    name: "Typescript",
    underline: false,
    tooltip: "Makes javascript slightly less unbearable. Slightly.",
  },
  {
    name: "Svelte",
    underline: false,
    tooltip: "What this site used to be built with!",
  },
  {
    name: "Astro",
    underline: false,
    tooltip: "What this site is built with now !!!!",
  },
  {
    name: "C#",
    tooltip: "Most of my C# work is for unity editor tools & apps",
  },
  {
    name: "U#",
    url: "https://udonsharp.docs.vrchat.com/",
    tooltip:
      'UdonSharp, VRChat\'s restricted C# flavor that is compiled down to their own "udon" bytecode',
  },
  {
    name: "English",
    url: "https://en.wikipedia.com",
    tooltip: "yeah...",
    underline: false
  }
];
---

<!-- small giggle, literally ***all*** of the tailwind was removed from this page and it looked exactly the same
 what the fuck were you doing lils
 - lucia -->
<CoreLayout title="Lillith's Site~<3" alter="Lillith">
  <main>
    <h1>Hey there, I'm LillithRosePup!</h1>
    <div>
      <p>
        I'm a programmer, namely working in Typescript, and interested in
        others!
      </p>
      <p>
        You can always find me around the <a
          href="https://abyssalfragments.org"
          target="_blank">Abyssal Fragments</a
        > community!
      </p>
    </div>
    <div>
      <h2>Small things about me</h2>
      <ul>
        {
          smallThings.map((thing) =>
            typeof thing === "string" ? (
              <li>{thing}</li>
            ) : (
              <li>
                <Tooltip text={thing[1]} underline={thing[2]}>
                  {thing[0]}
                </Tooltip>
              </li>
            ),
          )
        }
      </ul>
    </div>
    <div>
      <h2>Languages I Know</h2>
      <ul>
        {
          languages.map((lang) => {
            const body = lang.url ? (
              <a href={lang.url}>{lang.name}</a>
            ) : (
              <span>{lang.name}</span>
            );
            return (
              <li>
                {lang.tooltip ? (
                  <Tooltip text={lang.tooltip} underline={lang.underline}>
                    {body}
                  </Tooltip>
                ) : (
                  body
                )}
              </li>
            );
          })
        }
      </ul>
    </div>

    <NowPlaying server:defer />

    <section class="sitekey">
      <h2>Site Key</h2>
      <ul>
        <li>
          Underlined text <Tooltip text="Like This!">has a Tooltip</Tooltip>
        </li>
        <li>
          <a target="_blank" href="https://petoftheday.com/"
            >Italic text is a link</a
          >
        </li>
        <li>
          <Tooltip text="oo cat!"
            ><a target="_blank" href="https://catoftheday.com/"
              >Links can have tooltips too</a
            ></Tooltip
          >
        </li>
        <li>
          <Tooltip text="sneaky :3" underline={false}
            ><a target="_blank" href="https://dogoftheday.com/" class="plain"
              >Links and tooltips don't have to be visible</a
            ></Tooltip
          >
        </li>
      </ul>
    </section>
  </main>
</CoreLayout>

<style>
  /* main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  } */
  section {
    margin-top: 0.5rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background-color: var(--color-background-secondary);

    & > h2 {
      margin: 0 0 0.5rem;
      font-size: 1.25rem;
      line-height: 1.75rem;
    }
  }
  .sitekey.ul {
      /*list-disc list-inside text-sm flex flex-col*/
      list-style-position: inside;
      list-style-type: disc;
      text-sm
  }
</style>

import NowPlaying from "../components/NowPlaying.astro";
import CoreLayout from "../layouts/Core.astro";

// fuck this
const birthday = new Date("2006-11-17T05:00:00.000Z");
const now = new Date();
let age = now.getFullYear() - birthday.getFullYear();
const hadBirthday =
  now.getMonth() > birthday.getMonth() ||
  (now.getMonth() === birthday.getMonth() &&
    now.getDate() >= birthday.getDate());
if (!hadBirthday) age--;

/**
 * either a raw string, or [text, tooltip, showUnderline]
 */
const smallThings: (string | [string, string, boolean?])[] = [
  [
    `I'm ${age} years old.`,
    birthday.toLocaleDateString("en-US", { month: "long", year: "numeric" }),
  ],
];
const languages: {
  name: string;
  url?: string;
  tooltip?: string;
  underline?: boolean;
}[] = [
  {
    name: "Typescript",
    underline: false,
    tooltip: "Makes javascript slightly less unbearable. Slightly.",
  },
  {
    name: "Svelte",
    underline: false,
    tooltip: "What this site used to be built with!",
  },
  {
    name: "Astro",
    underline: false,
    tooltip: "What this site is built with now !!!!",
  },
  {
    name: "C#",
    tooltip: "Most of my C# work is for unity editor tools & apps",
  },
  {
    name: "U#",
    url: "https://udonsharp.docs.vrchat.com/",
    tooltip:
      'UdonSharp, VRChat\'s restricted C# flavor that is compiled down to their own "udon" bytecode',
  },
];
---


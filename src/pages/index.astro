<CoreLayout title="Lillith's Site~<3" alter="Lillith">
  <div>
    <h1>Hey there, I'm LillithRosePup!</h1>
    <div>
      <p>
        I'm a programmer, namely working in Typescript, and interested in
        others!
      </p>
      <p>
        You can always find me around the <a
          href="https://abyssalfragments.org"
          target="_blank">Abyssal Fragments</a
        > community!
      </p>
    </div>
    <div>
      <h2>Small things about me</h2>
      <ul>
        {
          // TODO: tooltips
          smallThings.map((thing) =>
            typeof thing === "string" ? <li>{thing}</li> : <li>{thing[0]}</li>,
          )
        }
      </ul>
    </div>
    <div>
      <h2>Languages I Know</h2>
      <ul>
        {
          // once again
          // TODO: tooltips
          languages.map((lang) => (
            <li>
              {lang.url ? (
                <a href={lang.url}>{lang.name}</a>
              ) : (
                <span>{lang.name}</span>
              )}
            </li>
          ))
        }
        <!-- {#each languages as language (language)}

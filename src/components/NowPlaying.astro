---
import { Image } from "astro:assets";
import { LASTFM_API_KEY, LASTFM_USER } from "astro:env/client";
// ported from website-svelte, no live update :frowner:
export type TrackData = {
  name: string;
  album: string;
  artist: string;
  url: string;
  imageUrl: string;
};

async function load() {
  if (!LASTFM_API_KEY) return null;
  const params = new URLSearchParams({
    method: "user.getrecenttracks",
    api_key: LASTFM_API_KEY,
    user: LASTFM_USER,
    limit: "1",
    format: "json",
  });

  const res = await fetch(`https://ws.audioscrobbler.com/2.0/?${params}`);
  if (!res.ok) throw `${res.status} ${res.statusText}`;

  const json = await res.json();
  if (json.error) {
    console.error(`Error fetching track data: ${json.error}: ${json.message}`);
    return null;
  }

  const track = json.recenttracks?.track[0];

  if (!track?.["@attr"]?.nowplaying) {
    return null;
  }

  return {
    name: track.name || "Unknown",
    album: track.album["#text"],
    artist: track.artist["#text"] || "Unknown",
    url: track.url,
    imageUrl: track.image?.find((x: { size: string }) => x.size === "large")?.[
      "#text"
    ],
  };
}
const trackData = await load();
---

{
  trackData && (
    <section>
      <h2>
        <a href="https://music.lilyy.gay" target="_blank">
          Now Playing
        </a>
      </h2>
      <div class="track">
        {trackData.imageUrl && (
          <Image
            src={trackData.imageUrl}
            alt="{trackData.artist} - {trackData.name}"
            width={80}
            height={80}
            class="cover"
            loading="eager"
          />
        )}
        <div class="details">
          <p class="name">
            {trackData.url ? (
              <a
                href={trackData.url}
                target="_blank"
                rel="noopener noreferrer external"
              >
                {trackData.name}
              </a>
            ) : (
              trackData.name
            )}
          </p>
          <p class="artist">{trackData.artist}</p>
          {trackData.album && <p class="album">{trackData.album}</p>}
        </div>
      </div>
    </section>
  )
}

<style>
  section {
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background-color: var(--color-background-secondary);

    & > h2 {
      margin: 0 0 0.5rem;
      font-size: 1.25rem;
      line-height: 1.75rem;
    }

    & > .track {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    & .cover {
      border-radius: 0.25rem;
      object-fit: cover;
    }

    & .details {
      flex: 1;
    }

    & .name {
      margin: 0;
      font-weight: 600;
    }

    & .artist,
    & .album {
      margin: 0;
      color: color-mix(in srgb, currentColor 65%, transparent);
    }

    & .artist {
      font-size: 0.875rem;
      line-height: 1.25rem;
    }

    & .album {
      font-size: 0.75rem;
      line-height: 1rem;
    }
  }
</style>

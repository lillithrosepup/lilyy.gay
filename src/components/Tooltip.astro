---
interface Props {
  text: string;
  underline?: boolean;
}

const { text, underline = true } = Astro.props;
---

<span class:list={["tooltip", { underline }]}>
  <span class="text">{text}</span>
  <slot />
</span>

<style>
  .underline {
    text-decoration-line: underline;
  }
  .tooltip {
    position: relative;
  }
  .text {
    visibility: hidden;
    opacity: 0;
    position: absolute;
    max-width: 500px;
    min-width: max-content;
    bottom: calc(100% + 0.25rem);
    z-index: 1;
    text-decoration-line: unset;
    transition: opacity 0.3s;
    background-color: var(--color-background-secondary);
    padding: 5px;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    pointer-events: none;
  }
  .tooltip:hover .text {
    visibility: visible;
    opacity: 1;
  }
</style>
